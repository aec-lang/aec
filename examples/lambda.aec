# Lambdas: `x => expr`, `x, y => expr`, `=> expr`
#
# Run:
#   aec run examples/lambda.aec --cli --entry main
#
# Capture is by move: a lambda snapshots the values it closes over at the moment
# it is created, so later changes to the original binding do not affect it.
# `function` is the type of any function value (a top-level `fn` or a lambda).

agent LambdaDemo

fn make_adder(n: int) -> function {
    return x => x + n
}

fn apply(f: function, v: int) -> int {
    return f(v)
}

fn main() -> int {
    let add5 = make_adder(5)
    print("add5(10) =", add5(10))

    let mul = a, b => a * b
    print("mul(6, 7) =", mul(6, 7))

    print("apply(x => x * 3, 4) =", apply(x => x * 3, 4))

    # by-move capture: add_base keeps base = 1, even though base becomes 1000
    var base = 1
    let add_base = x => x + base
    base = 1000
    print("captured by move: add_base(1) =", add_base(1))

    return 0
}
